@page "/error"
@{
    ViewData["Title"] = "Something went wrong";
    ViewData["Description"] = "Something went wrong on our side.";
    ViewData["NoIndex"] = true;
    Response.StatusCode = 500;
}
<section class="band lost">
    <div class="wrap prose">
        <p class="eyebrow">A stumble</p>
        <h1>The hearth has gone out</h1>
        <p>Something went wrong on our side, and it is not your doing. Please try again in a moment.</p>
        <div class="actions"><a class="btn" href="/">Back to the village</a></div>
    </div>
</section>
