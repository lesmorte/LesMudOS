@page "/play"
@{
    ViewData["Title"] = "Play in your browser";
    ViewData["Description"] = "Play Legends of Hollowmere in your web browser, on a computer or a phone.";
    ViewData["NoIndex"] = true;
    var on = PlayClient.IsOn();
    ViewData["PlayPage"] = on;
}
@if (!on)
{
    <section class="band">
        <div class="wrap">
            <p class="eyebrow">Enter Hollowmere</p>
            <h1>The browser client is switched off</h1>
            <div class="prose">
                <p>Playing in the browser is not available right now. You can still play with a MUD client or plain telnet: the instructions are on the <a href="/how-to-play">How to play</a> page.</p>
            </div>
        </div>
    </section>
}
else
{
    <div id="play" class="play" data-ws="/play/ws" data-status="/play/status" data-protocol="hollowmere.v1">
        <section class="play-main" aria-label="Game">
            <header class="play-bar">
                <h1 class="play-title">Legends of Hollowmere</h1>
                <span id="play-state" class="play-state" role="status">Not connected</span>
                <button type="button" id="play-pause" class="play-btn" aria-pressed="false" hidden>Pause announcements</button>
                <a class="play-link" href="/how-to-play">How to play</a>
            </header>

            <div id="play-start" class="play-start">
                <noscript><p class="play-warn">The browser client needs JavaScript. You can still play with a MUD client or telnet: see <a href="/how-to-play">How to play</a>.</p></noscript>
                <p id="play-notice" class="play-notice" hidden></p>
                <button type="button" id="play-enter" class="play-enter" hidden>Enter Hollowmere</button>
                <p class="play-fine">Your password travels over HTTPS to Cloudflare, which carries it to the game. Use a password you use nowhere else.</p>
            </div>

            <div id="play-strip" class="play-strip" hidden>
                <span>Type commands and press Enter. Try <button type="button" class="play-code" data-insert="look">look</button>, <button type="button" class="play-code" data-insert="north">north</button> and <button type="button" class="play-code" data-insert="help">help</button>.</span>
                <button type="button" id="play-strip-hide" class="play-btn">Hide</button>
            </div>

            <div class="play-logwrap">
                <div id="play-log" class="play-log" role="log" aria-live="polite" aria-label="Game output" tabindex="0" hidden></div>
                <button type="button" id="play-newlines" class="play-newlines" hidden></button>
            </div>

            <div id="play-banner" class="play-banner" hidden>
                <span id="play-banner-text"></span>
                <button type="button" id="play-try" class="play-btn">Try now</button>
                <button type="button" id="play-stop" class="play-btn">Stop</button>
            </div>

            <div id="play-closed" class="play-banner" hidden>
                <span id="play-closed-text">Disconnected.</span>
                <button type="button" id="play-reconnect" class="play-btn">Reconnect</button>
            </div>

            <form id="play-form" class="play-form" autocomplete="off" hidden>
                <label for="play-input" class="play-sr">Command</label>
                <input id="play-input" class="play-input" type="text" maxlength="1000" autocapitalize="off" autocorrect="off" autocomplete="off" spellcheck="false" enterkeyhint="send">
                <button type="submit" class="play-send">Send</button>
            </form>
        </section>

        @* The side panel (status, exits, chat, map) arrives in later stages and goes here. *@
        <aside id="play-side" class="play-side" aria-label="Character" hidden></aside>
    </div>
}
