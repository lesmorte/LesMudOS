[Unit]
Description=LesMudOS game driver
After=network-online.target
Wants=network-online.target

[Service]
User=lesmudos
Group=lesmudos
WorkingDirectory=/opt/lesmudos
# Optional: a root-only file containing LESMUDOS_ADMIN_SECRET=..., needed once
# to create the first level-10 wizard. Remove it afterwards.
EnvironmentFile=-/etc/lesmudos.env
ExecStart=/opt/lesmudos/bin/LesMudOS.Driver --mudlib /opt/lesmudos/mudlib --save /opt/lesmudos/save --port 4000
Restart=on-failure
RestartSec=5

# Confine the process: the mudlib sandbox is not a security boundary.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/lesmudos/save
# A ceiling for the driver: a wizard's code can allocate until the process is killed (docs/SANDBOX.md section 7), and this keeps
# that to the driver (restarted by Restart=on-failure, as after the stall watchdog's exit code 3) instead of the whole machine.
MemoryMax=768M
MemorySwapMax=0
# .NET's own heap limit, below the ceiling (hex percent of it: 0x46 = 70%): an allocation past it fails as an error in the code
# that made it, instead of the kernel killing the process; the driver saves everyone at three quarters of it.
Environment=DOTNET_GCHeapHardLimitPercent=0x46

[Install]
WantedBy=multi-user.target
