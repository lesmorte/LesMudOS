[Unit]
Description=LesMudOS game driver
After=network-online.target
Wants=network-online.target

[Service]
User=lesmudos
Group=lesmudos
WorkingDirectory=/opt/lesmudos
# Optional: a root-only file containing LESMUDOS_ADMIN_SECRET=..., needed once
# to create the first level-10 wizard. Remove it afterwards.
EnvironmentFile=-/etc/lesmudos.env
ExecStart=/opt/lesmudos/bin/LesMudOS.Driver --mudlib /opt/lesmudos/mudlib --save /opt/lesmudos/save --port 4000
Restart=on-failure
RestartSec=5

# Confine the process: the mudlib sandbox is not a security boundary.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/lesmudos/save
MemoryMax=768M

[Install]
WantedBy=multi-user.target
